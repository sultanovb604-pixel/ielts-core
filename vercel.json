{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,*.css,english-*.js,admin.js,firebase-config.js,listening-engine.js,speaking-avatar.js,speaking-recorder.js,assets/**,data/**,english-reading-materials/**,english-listening-materials/**,vendor/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/((?!maintenance|assets|favicon).*$)",
      "destination": "/maintenance.html",
      "permanent": false
    },
    {
      "source": "/english/predictions",
      "destination": "/english/mock-tests",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/maintenance.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
