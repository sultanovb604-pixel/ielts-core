# ==============================================================================
# IELTS CORE (VORTEX ENGLISH) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port and Node Environment
PORT=4173
NODE_ENV=production

# Generate a unique 64+ character secret for student/admin session tokens.
# Never reuse this placeholder in production.
SESSION_SECRET=replace_with_a_unique_random_secret_at_least_64_characters_long

# Super-Administrator Credentials (for /admin panel)
ADMIN_EMAIL=owner@example.com
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production
ADMIN_PIN=change_this_to_a_unique_2fa_pin

# Optional: Neon Serverless PostgreSQL Database Connection
# If left empty, IELTS Core safely stores data in data/vortex-data.json
DATABASE_URL=

# Optional: Supabase REST sync. Keep the secret key in Vercel environment
# variables only; never commit a real key to source control.
SUPABASE_URL=
SUPABASE_KEY=

# Optional: Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ieltscore.org/api/auth/google/callback

# Firebase ID-token verification for Google sign-in
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Optional AI speaking assessment. Configure only in Vercel environment variables.
GEMINI_API_KEY=
